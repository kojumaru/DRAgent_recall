# fta-spec-generator リポジトリのローカルパス（デフォルト: ../fta-spec-generator）
# 仕様書生成（agent.py）の呼び出しと、raw.json / spec_FTA.md の取り込みに使う。
# リコール収集そのものは fta-spec-generator 側の責務（collect_recalls.py）で、
# このリポジトリは収集ロジックを持たない。
# FTA_SPEC_GENERATOR_ROOT=/path/to/fta-spec-generator

# Azure OpenAI（label抽出・judge・objective_evalの埋め込み照合で使用）
AZURE_OPENAI_ENDPOINT=
AZURE_OPENAI_API_KEY=
AZURE_OPENAI_DEPLOYMENT=gpt-5.2
AZURE_OPENAI_API_VERSION=2025-04-01-preview
# objective_eval.py の意味照合で使用。Azure側にこの名前のデプロイがない場合、
# 自動でローカル埋め込み（下記 LOCAL_EMBEDDING_MODEL）にフォールバックする
AZURE_OPENAI_EMBEDDING_DEPLOYMENT=text-embedding-3-large

# ローカル埋め込み（sentence-transformers）。Azure埋め込みが未設定/失敗時に使う。
# API不要・無料・オフライン動作。日本語対応の多言語モデルが既定
# LOCAL_EMBEDDING_MODEL=paraphrase-multilingual-mpnet-base-v2
